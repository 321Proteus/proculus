      "tags": [
        "php",
        "language"
      ],
      "signals": [
        {
          "weight": 0.95,
          "match": {
            "field": "header:x-powered-by",
            "op": "regex",
            "value": "^PHP(/|$)"
          }
        },
        {
          "weight": 0.7,
          "match": {
            "field": "cookie",
            "op": "equals",
            "value": "PHPSESSID"
          }
        }
      ],
      "version": {
        "field": "header:x-powered-by",
        "regex": "PHP/([0-9][0-9.]*)"
      },
      "examples": [
        {
          "name": "header",
          "evidence": {
            "header:x-powered-by": "PHP/8.2.12"
          },
          "version": "8.2.12"
        },
        {
          "name": "session cookie",
          "evidence": {
            "cookie": [
              "PHPSESSID"
            ]
          }
        },
        {
          "name": "express",
          "evidence": {
            "header:x-powered-by": "Express"
          },
          "expect": "no-match"
        }
      ]
    },
