    {
      "id": "exposed-spring-actuator",
      "name": "Spring Boot actuator exposed",
      "category": "other",
      "tags": [
        "exposure",
        "java"
      ],
      "interest": 4,
      "description": "Management endpoints (environment, heap dumps, ...) can be reachable without authentication.",
      "signals": [
        {
          "weight": 0.95,
          "match": {
            "all": [
              {
                "field": "path:/actuator:status",
                "op": "equals",
                "value": [
                  200
                ]
              },
              {
                "field": "path:/actuator:body",
                "op": "contains",
                "value": "\"_links\""
              }
            ]
          },
          "label": "/actuator"
        },
        {
          "weight": 0.85,
          "match": {
            "all": [
              {
                "field": "path:/actuator/health:status",
                "op": "equals",
                "value": [
                  200
                ]
              },
              {
                "field": "path:/actuator/health:body",
                "op": "regex",
                "value": "\\\"status\\\"\\s*:\\s*\\\"(UP|DOWN|OUT_OF_SERVICE)\\\""
              }
            ]
          },
          "label": "/actuator/health"
        }
      ],
      "examples": [
        {
          "name": "index",
          "evidence": {
            "path:/actuator:status": 200,
            "path:/actuator:body": "{\"_links\":{\"self\":{\"href\":\"/actuator\"}}}"
          }
        },
        {
          "name": "health",
          "evidence": {
            "path:/actuator/health:status": 200,
            "path:/actuator/health:body": "{\"status\":\"UP\"}"
          }
        },
        {
          "name": "missing",
          "evidence": {
            "path:/actuator:status": 404
          },
          "expect": "no-match"
        }
      ]
    },
