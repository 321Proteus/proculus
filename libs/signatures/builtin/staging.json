{
  "format": 1,
  "signatures": [
    {
      "id": "staging-host-name",
      "name": "Test / staging host name",
      "category": "staging",
      "tags": [
        "environment"
      ],
      "interest": 3,
      "description": "The name suggests a non-production system (dev, test, staging, uat, qa, preprod, sandbox, demo). These are often less protected than production.",
      "signals": [
        {
          "weight": 0.7,
          "match": {
            "field": "host",
            "op": "regex",
            "value": "^(dev|test|staging|stage|stg|uat|qa|preprod|pre-prod|sandbox|demo)[0-9]*[.-]"
          },
          "label": "host name"
        },
        {
          "weight": 0.7,
          "match": {
            "field": "hostnames",
            "op": "regex",
            "value": "^(dev|test|staging|stage|stg|uat|qa|preprod|pre-prod|sandbox|demo)[0-9]*[.-]"
          },
          "label": "DNS name"
        }
      ],
      "examples": [
        {
          "name": "staging",
          "evidence": {
            "host": "staging.example.org"
          }
        },
        {
          "name": "dns name",
          "evidence": {
            "hostnames": [
              "uat-portal.example.org"
            ]
          }
        },
        {
          "name": "numbered",
          "evidence": {
            "host": "dev2.example.org"
          }
        },
        {
          "name": "production",
          "evidence": {
            "host": "www.example.org"
          },
          "expect": "no-match"
        },
        {
          "name": "word inside",
          "evidence": {
            "host": "contest.example.org"
          },
          "expect": "no-match"
        }
      ]
    },
    {
      "id": "staging-title",
      "name": "Test / staging page title",
      "category": "staging",
      "tags": [
        "environment"
      ],
      "interest": 3,
      "description": "The page labels itself as a non-production system. A title that merely mentions the word (a blog post about staging) does not count.",
      "signals": [
        {
          "weight": 0.6,
          "match": {
            "field": "title",
            "op": "regex",
            "value": [
              "\\((staging|stage|test|testing|uat|qa|dev|development|preprod|pre-production|sandbox)\\)|\\[(staging|stage|test|testing|uat|qa|dev|development|preprod|pre-production|sandbox)\\]",
              "[-|:] ?(staging|uat|qa|sandbox|preprod|pre-production)$",
              "\\b(staging|stage|test|testing|uat|qa|dev|development|preprod|pre-production|sandbox) (environment|server|site|instance|system)\\b",
              "\\bpre-?production\\b|not for production"
            ]
          }
        }
      ],
      "examples": [
        {
          "name": "parenthesised",
          "evidence": {
            "title": "Acme Portal (STAGING)"
          }
        },
        {
          "name": "bracketed",
          "evidence": {
            "title": "[TEST] Acme Portal"
          }
        },
        {
          "name": "trailing label",
          "evidence": {
            "title": "Acme Portal - UAT"
          }
        },
        {
          "name": "environment word",
          "evidence": {
            "title": "Staging server"
          }
        },
        {
          "name": "preprod",
          "evidence": {
            "title": "Pre-production login"
          }
        },
        {
          "name": "not for production",
          "evidence": {
            "title": "Acme (not for production use)"
          }
        },
        {
          "name": "normal",
          "evidence": {
            "title": "Acme Portal"
          },
          "expect": "no-match"
        },
        {
          "name": "marketing demo",
          "evidence": {
            "title": "Product demo video"
          },
          "expect": "no-match"
        },
        {
          "name": "blog about staging",
          "evidence": {
            "title": "Engineering blog - how we run staging and the admin console"
          },
          "expect": "no-match"
        },
        {
          "name": "testing as a topic",
          "evidence": {
            "title": "Testing your code: a guide"
          },
          "expect": "no-match"
        },
        {
          "name": "development guide",
          "evidence": {
            "title": "Development guide"
          },
          "expect": "no-match"
        }
      ]
    },
    {
      "id": "staging-header",
      "name": "Environment header says test / staging",
      "category": "staging",
      "tags": [
        "environment"
      ],
      "interest": 3,
      "signals": [
        {
          "weight": 0.9,
          "match": {
            "field": "header:x-environment",
            "op": "contains",
            "value": [
              "dev",
              "test",
              "stag",
              "qa",
              "uat",
              "preprod",
              "sandbox"
            ]
          }
        },
        {
          "weight": 0.9,
          "match": {
            "field": "header:x-env",
            "op": "contains",
            "value": [
              "dev",
              "test",
              "stag",
              "qa",
              "uat",
              "preprod",
              "sandbox"
            ]
          }
        },
        {
          "weight": 0.9,
          "match": {
            "field": "header:x-app-env",
            "op": "contains",
            "value": [
              "dev",
              "test",
              "stag",
              "qa",
              "uat",
              "preprod",
              "sandbox"
            ]
          }
        },
        {
          "weight": 0.35,
          "match": {
            "field": "header:x-robots-tag",
            "op": "contains",
            "value": "noindex"
          },
          "label": "hidden from search engines"
        }
      ],
      "examples": [
        {
          "name": "x-environment",
          "evidence": {
            "header:x-environment": "staging"
          }
        },
        {
          "name": "x-env",
          "evidence": {
            "header:x-env": "uat"
          }
        },
        {
          "name": "production",
          "evidence": {
            "header:x-environment": "production"
          },
          "expect": "no-match"
        },
        {
          "name": "noindex alone",
          "evidence": {
            "header:x-robots-tag": "noindex, nofollow"
          },
          "expect": "no-match"
        }
      ]
    },
    {
      "id": "debug-django",
      "name": "Django debug mode on",
      "category": "staging",
      "tags": [
        "debug",
        "python"
      ],
      "interest": 5,
      "description": "The detailed Django error page is shown to visitors: it leaks settings, paths and code.",
      "signals": [
        {
          "weight": 0.95,
          "match": {
            "field": "body",
            "op": "contains",
            "value": "You're seeing this error because you have"
          }
        },
        {
          "weight": 0.8,
          "match": {
            "field": "title",
            "op": "regex",
            "value": "^DisallowedHost at"
          }
        }
      ],
      "examples": [
        {
          "name": "debug page",
          "evidence": {
            "body": "<p>You're seeing this error because you have <code>DEBUG = True</code> in your settings</p>"
          }
        },
        {
          "name": "disallowed host",
          "evidence": {
            "title": "DisallowedHost at /"
          }
        },
        {
          "name": "normal",
          "evidence": {
            "body": "<h1>Not Found</h1>"
          },
          "expect": "no-match"
        }
      ]
    },
    {
      "id": "debug-laravel",
      "name": "Laravel debug mode on",
      "category": "staging",
      "tags": [
        "debug",
        "php"
      ],
      "interest": 5,
      "threshold": 0.8,
      "signals": [
        {
          "weight": 0.9,
          "match": {
            "field": "body",
            "op": "contains",
            "value": "Whoops! There was an error."
          }
        },
        {
          "weight": 0.9,
          "match": {
            "field": "body",
            "op": "contains",
            "value": "facade/ignition"
          }
        }
      ],
      "examples": [
        {
          "name": "whoops",
          "evidence": {
            "body": "<div>Whoops! There was an error.</div>"
          }
        },
        {
          "name": "ignition",
          "evidence": {
            "body": "<script src=\"/_ignition/x.js\">facade/ignition"
          }
        },
        {
          "name": "normal",
          "evidence": {
            "body": "<h1>500</h1>"
          },
          "expect": "no-match"
        }
      ]
    },
    {
      "id": "debug-symfony-profiler",
      "name": "Symfony profiler enabled",
      "category": "staging",
      "tags": [
        "debug",
        "php"
      ],
      "interest": 4,
      "signals": [
        {
          "weight": 0.95,
          "match": {
            "field": "header:x-debug-token-link",
