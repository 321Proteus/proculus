          }
        },
        {
          "weight": 0.8,
          "match": {
            "field": "header:x-debug-token",
            "op": "exists"
          }
        }
      ],
      "examples": [
        {
          "name": "link header",
          "evidence": {
            "header:x-debug-token-link": "/_profiler/abc123"
          }
        },
        {
          "name": "none",
          "evidence": {
            "header:server": "nginx"
          },
          "expect": "no-match"
        }
      ]
    },
    {
      "id": "debug-werkzeug-console",
      "name": "Werkzeug interactive debugger",
      "category": "staging",
      "tags": [
        "debug",
        "python"
      ],
      "interest": 5,
      "description": "The Flask/Werkzeug debugger allows running Python code from the browser.",
      "signals": [
        {
          "weight": 0.95,
          "match": {
            "field": "body",
            "op": "contains",
            "value": "The debugger caught an exception"
          }
        },
        {
          "weight": 0.95,
          "match": {
            "all": [
              {
                "field": "path:/console:status",
                "op": "equals",
                "value": [
                  200
                ]
              },
              {
                "field": "path:/console:title",
                "op": "contains",
                "value": "Console"
              }
            ]
          },
          "label": "/console"
        }
      ],
      "examples": [
        {
          "name": "traceback page",
          "evidence": {
            "body": "<p>The debugger caught an exception in your WSGI application.</p>"
          }
        },
        {
          "name": "console",
          "evidence": {
            "path:/console:status": 200,
            "path:/console:title": "Interactive Console"
          }
        },
        {
          "name": "none",
          "evidence": {
            "body": ""
          },
          "expect": "no-match"
        }
      ]
    },
    {
      "id": "debug-dotnet-error",
      "name": "ASP.NET detailed error page",
      "category": "staging",
      "tags": [
        "debug",
        "dotnet"
      ],
      "interest": 4,
      "threshold": 0.6,
      "signals": [
        {
          "weight": 0.95,
          "match": {
            "field": "title",
            "op": "regex",
            "value": "^Server Error in '.*' Application"
          }
        },
        {
          "weight": 0.9,
          "match": {
            "field": "body",
            "op": "contains",
            "value": "Stack Trace:"
          }
        }
      ],
      "examples": [
        {
          "name": "yellow screen",
          "evidence": {
            "title": "Server Error in '/' Application"
          }
        },
        {
          "name": "none",
          "evidence": {
            "title": "Error"
          },
          "expect": "no-match"
        }
      ]
    },
    {
      "id": "debug-stack-trace",
      "name": "Stack trace shown in the page",
      "category": "staging",
      "tags": [
        "debug"
      ],
      "interest": 3,
      "description": "An error page that discloses code paths and library versions.",
      "signals": [
        {
          "weight": 0.9,
          "match": {
            "field": "body",
            "op": "contains",
            "value": "Traceback (most recent call last)"
          }
        },
        {
          "weight": 0.8,
          "match": {
            "field": "body",
            "op": "regex",
            "value": "\\bat (org|java|javax|com|net)\\.[A-Za-z0-9_.$]+\\([A-Za-z0-9_]+\\.java:[0-9]+\\)"
          }
        },
        {
          "weight": 0.8,
          "match": {
            "field": "body",
            "op": "regex",
            "value": "(Fatal error|Parse error|Warning|Notice)(</b>)?: .{1,200} on line (<b>)?[0-9]+"
          },
          "label": "PHP error message"
        }
      ],
      "examples": [
        {
          "name": "python",
          "evidence": {
            "body": "Traceback (most recent call last):\n  File \"app.py\", line 3"
          }
        },
        {
          "name": "java",
          "evidence": {
            "body": "at com.example.app.Main.run(Main.java:42)"
          }
        },
        {
          "name": "php",
          "evidence": {
            "body": "<b>Warning</b>: Undefined variable in /var/www/x.php on line 12"
          }
        },
        {
          "name": "php html output",
          "evidence": {
            "body": "<br />\n<b>Warning</b>:  Undefined variable $x in <b>/var/www/html/index.php</b> on line <b>12</b><br />"
          }
        },
        {
          "name": "php fatal",
          "evidence": {
            "body": "Fatal error: Uncaught Error: Call to undefined function foo() in /var/www/a.php on line 7"
          }
        },
        {
          "name": "normal",
          "evidence": {
            "body": "<h1>Oops</h1>"
          },
          "expect": "no-match"
        }
      ]
    },
    {
      "id": "exposed-git",
      "name": "Exposed .git directory",
      "category": "other",
      "tags": [
        "exposure",
        "source-code"
      ],
      "interest": 5,
      "description": "The repository metadata is downloadable; the source code and history can usually be reconstructed from it.",
      "signals": [
        {
          "weight": 0.95,
          "match": {
            "all": [
              {
                "field": "path:/.git/HEAD:status",
                "op": "equals",
                "value": [
                  200
                ]
              },
              {
                "field": "path:/.git/HEAD:body",
                "op": "regex",
                "value": "^ref: refs/"
              }
            ]
          },
          "label": "/.git/HEAD readable"
        }
      ],
      "examples": [
        {
          "name": "readable",
          "evidence": {
            "path:/.git/HEAD:status": 200,
            "path:/.git/HEAD:body": "ref: refs/heads/main\n"
          }
        },
        {
          "name": "not found",
          "evidence": {
            "path:/.git/HEAD:status": 404
          },
          "expect": "no-match"
        },
        {
          "name": "soft 404 page",
          "evidence": {
            "path:/.git/HEAD:status": 200,
            "path:/.git/HEAD:body": "<html>Not found</html>"
          },
          "expect": "no-match"
        }
      ]
    },
    {
