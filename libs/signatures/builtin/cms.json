{
  "format": 1,
  "signatures": [
    {
      "id": "wordpress",
      "name": "WordPress",
      "category": "cms",
      "tags": [
        "php",
        "blog"
      ],
      "interest": 1,
      "signals": [
        {
          "weight": 0.7,
          "match": {
            "field": "body",
            "op": "contains",
            "value": "/wp-content/"
          },
          "label": "theme/plugin files"
        },
        {
          "weight": 0.95,
          "match": {
            "field": "body",
            "op": "regex",
            "value": "<meta[^>]+name=[\\\"']generator[\\\"'][^>]+content=[\\\"']WordPress"
          },
          "label": "generator tag"
        },
        {
          "weight": 0.9,
          "match": {
            "field": "header:link",
            "op": "contains",
            "value": "https://api.w.org/"
          },
          "label": "REST API link"
        },
        {
          "weight": 0.9,
          "match": {
            "field": "cookie",
            "op": "regex",
            "value": "^(wordpress_|wp-settings-|wordpress_test_cookie)"
          },
          "label": "WordPress cookie"
        },
        {
          "weight": 0.95,
          "match": {
            "all": [
              {
                "field": "path:/wp-login.php:status",
                "op": "equals",
                "value": [
                  200
                ]
              },
              {
                "field": "path:/wp-login.php:body",
                "op": "contains",
                "value": "wp-submit"
              }
            ]
          },
          "label": "login page"
        }
      ],
      "version": {
        "field": "body",
        "regex": "content=[\\\"']WordPress ([0-9][0-9.]*)"
      },
      "examples": [
        {
          "name": "generator",
          "evidence": {
            "body": "<meta name=\"generator\" content=\"WordPress 6.4.2\" />"
          },
          "version": "6.4.2"
        },
        {
          "name": "login page",
          "evidence": {
            "path:/wp-login.php:status": 200,
            "path:/wp-login.php:body": "<input name=\"wp-submit\">"
          }
        },
        {
          "name": "theme files",
          "evidence": {
            "body": "<link href=\"/wp-content/themes/x/style.css\">",
            "cookie": [
              "wordpress_test_cookie"
            ]
          }
        },
        {
          "name": "plain",
          "evidence": {
            "body": "<html></html>"
          },
          "expect": "no-match"
        }
      ]
    },
