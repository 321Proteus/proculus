    {
      "id": "elasticsearch",
      "name": "Elasticsearch API (open)",
      "category": "admin",
      "tags": [
        "database",
        "api",
        "panel"
      ],
      "interest": 4,
      "description": "An Elasticsearch node answering without authentication.",
      "signals": [
        {
          "weight": 0.95,
          "match": {
            "all": [
              {
                "field": "status",
                "op": "equals",
                "value": 200
              },
              {
                "field": "body",
                "op": "contains",
                "value": "You Know, for Search"
              }
            ]
          },
          "label": "root answer"
        }
      ],
      "version": {
        "field": "body",
        "regex": "\\\"number\\\"\\s*:\\s*\\\"([0-9][0-9.]*)\\\""
      },
      "examples": [
        {
          "name": "root",
          "evidence": {
            "status": 200,
            "body": "{\"name\":\"n1\",\"tagline\":\"You Know, for Search\",\"version\":{\"number\":\"8.11.1\"}}"
          },
          "version": "8.11.1"
        },
        {
          "name": "other json",
          "evidence": {
            "status": 200,
            "body": "{\"ok\":true}"
          },
          "expect": "no-match"
        }
      ]
    },
