    {
      "id": "phpmyadmin",
      "name": "phpMyAdmin",
      "category": "admin",
      "tags": [
        "database",
        "panel"
      ],
      "interest": 3,
      "description": "Web front end for MySQL/MariaDB.",
      "signals": [
        {
          "weight": 0.9,
          "match": {
            "field": "title",
            "op": "contains",
            "value": "phpMyAdmin"
          }
        },
        {
          "weight": 0.8,
          "match": {
            "field": "cookie",
            "op": "equals",
            "value": "pma_lang"
          }
        },
        {
          "weight": 0.7,
          "match": {
            "field": "cookie",
            "op": "equals",
            "value": "phpMyAdmin"
          }
        },
        {
          "weight": 0.95,
          "match": {
            "all": [
              {
                "field": "path:/phpmyadmin/:status",
                "op": "equals",
                "value": [
                  200
                ]
              },
              {
                "field": "path:/phpmyadmin/:title",
                "op": "contains",
                "value": "phpMyAdmin"
              }
            ]
          },
          "label": "/phpmyadmin/"
        }
      ],
      "examples": [
        {
          "name": "title",
          "evidence": {
            "title": "phpMyAdmin"
          }
        },
        {
          "name": "cookie",
          "evidence": {
            "cookie": [
              "pma_lang"
            ]
          }
        },
        {
          "name": "on a path",
          "evidence": {
            "path:/phpmyadmin/:status": 200,
            "path:/phpmyadmin/:title": "phpMyAdmin"
          }
        },
        {
          "name": "other page",
          "evidence": {
            "title": "My Shop"
          },
          "expect": "no-match"
        }
      ]
    },
