    {
      "id": "http-basic-auth",
      "name": "HTTP basic authentication prompt",
      "category": "admin",
      "tags": [
        "auth"
      ],
      "interest": 1,
      "description": "The page asks for a user name and password; the realm names what is protected.",
      "signals": [
        {
          "weight": 0.9,
          "match": {
            "all": [
              {
                "field": "status",
                "op": "equals",
                "value": 401
              },
              {
                "field": "header:www-authenticate",
                "op": "prefix",
                "value": "Basic"
              }
            ]
          }
        }
      ],
      "version": {
        "field": "header:www-authenticate",
        "regex": "realm=\\\"([A-Za-z0-9._-]+)\\\""
      },
      "examples": [
        {
          "name": "prompt",
          "evidence": {
            "status": 401,
            "header:www-authenticate": "Basic realm=\"Router\""
          },
          "version": "Router"
        },
        {
          "name": "401 with other scheme",
          "evidence": {
            "status": 401,
            "header:www-authenticate": "Bearer"
          },
          "expect": "no-match"
        },
        {
          "name": "200",
          "evidence": {
            "status": 200,
            "header:www-authenticate": "Basic realm=\"x\""
          },
          "expect": "no-match"
        }
      ]
    },
