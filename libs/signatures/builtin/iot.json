{
  "format": 1,
  "signatures": [
    {
      "id": "hikvision",
      "name": "Hikvision camera / recorder",
      "category": "iot",
      "tags": [
        "camera"
      ],
      "interest": 4,
      "description": "Network cameras are often exposed with default credentials and old firmware.",
      "signals": [
        {
          "weight": 0.8,
          "match": {
            "field": "header:server",
            "op": "regex",
            "value": "^(DNVRS-Webs|App-webs)"
          }
        },
        {
          "weight": 0.9,
          "match": {
            "field": "body",
            "op": "contains",
            "value": "/doc/page/login.asp"
          }
        },
        {
          "weight": 0.7,
          "match": {
            "field": "title",
            "op": "regex",
            "value": "\\bHikvision\\b"
          }
        }
      ],
      "examples": [
        {
          "name": "server",
          "evidence": {
            "header:server": "DNVRS-Webs"
          }
        },
        {
          "name": "login page",
          "evidence": {
            "body": "<script src=\"/doc/page/login.asp\">"
          }
        },
        {
          "name": "title",
          "evidence": {
            "title": "Hikvision Digital Technology"
          }
        },
        {
          "name": "none",
          "evidence": {
            "header:server": "nginx"
          },
          "expect": "no-match"
        }
      ]
    },
