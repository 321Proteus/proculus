{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cmake: configure",
			"type": "shell",
			"command": "cmake",
			"args": ["-S", ".", "-B", "build", "-DCMAKE_BUILD_TYPE=Debug"],
			"problemMatcher": []
		},
		{
			"label": "cmake: build",
			"type": "shell",
			"command": "cmake",
			"args": ["--build", "build", "--parallel"],
			"dependsOn": "cmake: configure",
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": ["$gcc"]
		},
		{
			// Wipes results-dev (accounts, edits, scan settings, saved runs) so the next start is a first run.
			"label": "proculus: fresh start (results-dev)",
			"type": "shell",
			"command": "${workspaceFolder}/build/services/gateway/gateway",
			"args": ["reset", "--store", "${workspaceFolder}/results-dev", "--runs", "--yes"],
			"dependsOn": "cmake: build",
			"problemMatcher": []
		}
	]
}
